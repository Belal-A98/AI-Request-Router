# Generate independent secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRR_SOURCE_KEY=REPLACE_WITH_32_RANDOM_CHARACTERS_MIN
AIRR_REVIEWER_KEY=REPLACE_WITH_DIFFERENT_32_RANDOM_CHARACTERS_MIN
DATABASE_URL=sqlite+pysqlite:///./airr.sqlite
AIRR_CLASSIFIER_MODE=rules
AIRR_ENABLE_EXTERNAL_DELIVERY=false
